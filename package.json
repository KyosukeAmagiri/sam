{
  "name": "wslsa-2027-pathway-explorer",
  "version": "1.0.0",
  "private": true,
  "description": "Interactive 2027 degree pathway explorer and PDF guide generator built from the WSLSA Degree Guides 2027 workbook.",
  "scripts": {
    "extract": "python3 scripts/extract_workbook.py",
    "validate": "python3 scripts/validate_data.py",
    "build": "python3 scripts/build_app.py",
    "test": "node tests/e2e.cjs",
    "test:pdf": "node tests/e2e.cjs --pdf",
    "samples": "node tests/e2e.cjs --samples"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  }
}
